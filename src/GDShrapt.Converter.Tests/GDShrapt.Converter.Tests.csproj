<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GDShrapt.Converter.Tests</RootNamespace>
    <AssemblyName>GDShrapt.Converter.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_repo\**\*" />
    <EmbeddedResource Remove="_repo\**\*" />
    <None Include="_repo\**\*" />
    <None Remove="_repo\**\bin\**" />
    <None Remove="_repo\**\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="$(MSTestVersion)" />
    <PackageReference Include="MSTest.TestFramework" Version="$(MSTestVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDShrapt.Converter\GDShrapt.Converter.csproj" />
  </ItemGroup>

</Project>